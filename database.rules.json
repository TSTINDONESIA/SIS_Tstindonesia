{
  "rules": {
    ".read": false,
    ".write": false,
    "interpreter": {
      ".read": false,
      ".write": false,
      "usher": {
        "$uid": {
          ".read": "auth!=null&&auth.uid===$uid",
          ".write": "auth!=null&&auth.uid===$uid&&(!newData.exists()||(newData.isString()&&root.child('interpreter/usherDaftar/'+newData.val()).exists()))"
        }
      },
      "usherDaftar": {
        ".read": false,
        "$key": {
          ".read": "auth!=null",
          ".write": "auth!=null&&root.child('interpreter/usher/'+auth.uid).exists()",
          ".validate": "$key.matches(/^62[0-9]{8,13}$/)&&newData.isString()&&newData.val().length>0&&newData.val().length<=80"
        }
      },
      "config": {
        ".read": "auth!=null",
        ".write": "auth!=null&&root.child('interpreter/usher/'+auth.uid).exists()"
      },
      "pinjam": {
        ".read": "auth!=null&&root.child('interpreter/usher/'+auth.uid).exists()",
        ".write": "auth!=null&&root.child('interpreter/usher/'+auth.uid).exists()",
        "$id": {
          ".read": "auth!=null&&data.child('uid').val()===auth.uid",
          ".write": "(auth!=null&&root.child('interpreter/usher/'+auth.uid).exists())||(auth!=null&&!data.exists()&&newData.child('status').val()==='dipinjam'&&newData.child('uid').val()===auth.uid&&newData.parent().parent().child('aktif').child(newData.child('kunci').val()).val()===$id)",
          ".validate": "newData.hasChildren(['nama','hp','institusi','receiver','waktu','status'])",
          "nama": {
            ".validate": "newData.isString()&&newData.val().length>0&&newData.val().length<=80"
          },
          "hp": {
            ".validate": "newData.isString()&&newData.val().length<=100&&(newData.val().matches(/^[0-9+ -]{6,20}$/)||newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/))"
          },
          "institusi": {
            ".validate": "newData.isString()&&newData.val().length>0&&newData.val().length<=100"
          },
          "receiver": {
            ".validate": "newData.isString()&&newData.val().matches(/^[A-Z0-9-]{1,8}$/)"
          },
          "waktu": {
            ".validate": "newData.val()===now"
          },
          "status": {
            ".validate": "newData.val()==='dipinjam'||newData.val()==='kembali'"
          },
          "kembaliWaktu": {
            ".validate": "newData.isNumber()"
          },
          "reminderTerakhir": {
            ".validate": "newData.isNumber()"
          },
          "reminderJumlah": {
            ".validate": "newData.isNumber()"
          },
          "uid": {
            ".validate": "newData.isString()&&newData.val().length<=64"
          },
          "catatanGanti": {
            ".validate": "newData.isString()&&newData.val().length<=200"
          },
          "kunci": {
            ".validate": "newData.isString()&&newData.val().matches(/^[A-Z0-9-]{1,8}$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "aktif": {
        ".read": "auth!=null&&root.child('interpreter/usher/'+auth.uid).exists()",
        ".write": "auth!=null&&root.child('interpreter/usher/'+auth.uid).exists()",
        "$rcv": {
          ".write": "(auth!=null&&root.child('interpreter/usher/'+auth.uid).exists())||(auth!=null&&!data.exists())",
          ".validate": "$rcv.matches(/^[A-Z0-9-]{1,8}$/)&&newData.isString()&&newData.parent().parent().child('pinjam').child(newData.val()).exists()"
        }
      },
      "nilai": {
        ".read": "auth!=null&&root.child('interpreter/usher/'+auth.uid).exists()",
        ".write": "auth!=null&&root.child('interpreter/usher/'+auth.uid).exists()",
        "$id": {
          ".read": "auth!=null&&data.child('uid').val()===auth.uid",
          ".write": "auth!=null&&!data.exists()&&newData.child('uid').val()===auth.uid&&root.child('interpreter/pinjam/'+$id+'/uid').val()===auth.uid&&root.child('interpreter/pinjam/'+$id+'/status').val()==='kembali'",
          ".validate": "newData.hasChildren(['pelayanan','alat','uid','waktu'])",
          "pelayanan": {
            ".validate": "newData.isNumber()&&newData.val()>=1&&newData.val()<=5&&newData.val()%1===0"
          },
          "alat": {
            ".validate": "newData.isNumber()&&newData.val()>=1&&newData.val()<=5&&newData.val()%1===0"
          },
          "komentar": {
            ".validate": "newData.isString()&&newData.val().length<=300"
          },
          "uid": {
            ".validate": "newData.isString()&&newData.val().length<=64"
          },
          "waktu": {
            ".validate": "newData.val()===now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}