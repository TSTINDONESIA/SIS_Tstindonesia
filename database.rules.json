{
  "rules": {
    ".read": false,
    ".write": false,
    "sis": {
      ".read": false,
      ".write": false,
      "sesi": {
        "$uid": {
          ".read": "auth!=null&&auth.uid===$uid",
          ".write": "auth!=null&&auth.uid===$uid&&(!newData.exists()||(newData.isString()&&newData.val().matches(/^62[0-9]{8,13}$/)&&(root.child('sis/nomor/'+newData.val()).exists()||root.child('sis/superDaftar/'+newData.val()).exists())))"
        }
      },
      "nomor": {
        "$hp": {
          ".read": "auth!=null",
          ".write": "auth!=null&&root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()",
          ".validate": "$hp.matches(/^62[0-9]{8,13}$/)&&newData.val()===true"
        }
      },
      "superDaftar": {
        "$hp": {
          ".read": "auth!=null",
          ".write": false
        }
      },
      "indeks": {
        ".read": "auth!=null&&root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()",
        "$eid": {
          ".write": "auth!=null&&root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()",
          ".validate": "$eid.matches(/^[a-z0-9]{4,12}$/)&&newData.val()===true"
        }
      },
      "tugas": {
        ".read": "auth!=null&&root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()",
        "$hp": {
          ".read": "auth!=null&&root.child('sis/sesi/'+auth.uid).val()===$hp",
          ".write": "auth!=null&&root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()",
          "$eid": {
            ".validate": "$eid.matches(/^[a-z0-9]{4,12}$/)&&newData.val()===true"
          }
        }
      },
      "unitAktif": {
        ".read": "auth!=null",
        "$unit": {
          ".write": "auth!=null&&((!data.exists()&&newData.exists()&&root.child('sis/acara/'+newData.child('acara').val()+'/status').val()==='aktif')||(data.exists()&&!newData.exists()&&(auth!=null&&(root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()||root.child('sis/acara/'+data.child('acara').val()+'/petugas/'+root.child('sis/sesi/'+auth.uid).val()).exists()))))",
          ".validate": "$unit.matches(/^[A-J](00[1-9]|0[1-9][0-9]|100)$/)&&newData.hasChildren(['acara','loan'])",
          "acara": {
            ".validate": "newData.isString()&&newData.val().matches(/^[a-z0-9]{4,12}$/)"
          },
          "loan": {
            ".validate": "newData.isString()&&newData.val().length>=1&&newData.val().length<=40"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "acara": {
        "$eid": {
          ".validate": "$eid.matches(/^[a-z0-9]{4,12}$/)",
          ".write": "auth!=null&&root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()",
          "meta": {
            ".read": "auth!=null",
            ".write": "auth!=null&&root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()",
            ".validate": "newData.hasChildren(['nama','tanggal','mulai','selesai'])",
            "nama": {
              ".validate": "newData.isString()&&newData.val().length>=1&&newData.val().length<=80"
            },
            "tanggal": {
              ".validate": "newData.isString()&&newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "mulai": {
              ".validate": "newData.isString()&&newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)"
            },
            "selesai": {
              ".validate": "newData.isString()&&newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)"
            },
            "dipesan": {
              ".validate": "newData.isNumber()&&newData.val()>=0&&newData.val()<=100000&&newData.val()%1===0"
            },
            "dibuat": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "config": {
            ".read": "auth!=null",
            ".write": "auth!=null&&(root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()||root.child('sis/acara/'+$eid+'/petugas/'+root.child('sis/sesi/'+auth.uid).val()).exists())",
            "jaminan": {
              "aktif": {
                ".validate": "newData.isBoolean()"
              },
              "jenis": {
                "$j": {
                  ".validate": "$j.matches(/^[a-z]{2,12}$/)&&newData.isBoolean()"
                }
              },
              "$other": {
                ".validate": false
              }
            },
            "teknisiNama": {
              ".validate": "newData.isString()&&newData.val().length>=0&&newData.val().length<=60"
            },
            "teknisiWa": {
              ".validate": "newData.isString()&&newData.val().length>=0&&newData.val().length<=20"
            },
            "pesan": {
              ".validate": "newData.isString()&&newData.val().length>=0&&newData.val().length<=500"
            },
            "channels": {
              "$c": {
                "nama": {
                  ".validate": "newData.isString()&&newData.val().length>=1&&newData.val().length<=40"
                },
                "no": {
                  ".validate": "newData.isString()&&newData.val().length>=1&&newData.val().length<=8"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "status": {
            ".read": "auth!=null",
            ".write": "auth!=null&&(root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()||root.child('sis/acara/'+$eid+'/petugas/'+root.child('sis/sesi/'+auth.uid).val()).exists())",
            ".validate": "newData.val()==='aktif'||newData.val()==='selesai'"
          },
          "petugas": {
            ".read": "auth!=null&&(root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()||root.child('sis/acara/'+$eid+'/petugas/'+root.child('sis/sesi/'+auth.uid).val()).exists())",
            ".write": "auth!=null&&root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()",
            "$hp": {
              ".validate": "$hp.matches(/^62[0-9]{8,13}$/)&&newData.isString()&&newData.val().length>=1&&newData.val().length<=80"
            }
          },
          "petugasAktif": {
            ".read": "auth!=null&&(root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()||root.child('sis/acara/'+$eid+'/petugas/'+root.child('sis/sesi/'+auth.uid).val()).exists())",
            "$hp": {
              ".write": "auth!=null&&root.child('sis/sesi/'+auth.uid).val()===$hp&&(root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()||root.child('sis/acara/'+$eid+'/petugas/'+root.child('sis/sesi/'+auth.uid).val()).exists())&&root.child('sis/acara/'+$eid+'/status').val()==='aktif'",
              ".validate": "$hp.matches(/^62[0-9]{8,13}$/)&&newData.hasChildren(['nama','waktu'])",
              "nama": {
                ".validate": "newData.isString()&&newData.val().length>=1&&newData.val().length<=80"
              },
              "waktu": {
                ".validate": "newData.val()===now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "pinjam": {
            ".read": "auth!=null&&(root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()||root.child('sis/acara/'+$eid+'/petugas/'+root.child('sis/sesi/'+auth.uid).val()).exists())",
            ".write": "auth!=null&&(root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()||root.child('sis/acara/'+$eid+'/petugas/'+root.child('sis/sesi/'+auth.uid).val()).exists())",
            "$id": {
              ".read": "auth!=null&&data.child('uid').val()===auth.uid",
              ".write": "(auth!=null&&(root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()||root.child('sis/acara/'+$eid+'/petugas/'+root.child('sis/sesi/'+auth.uid).val()).exists()))||(auth!=null&&!data.exists()&&newData.child('status').val()==='dipinjam'&&newData.child('uid').val()===auth.uid&&root.child('sis/acara/'+$eid+'/status').val()==='aktif'&&!root.child('sis/unitAktif/'+newData.child('receiver').val()).exists())",
              ".validate": "newData.hasChildren(['nama','hp','institusi','receiver','waktu','status','uid','grup'])",
              "nama": {
                ".validate": "newData.isString()&&newData.val().length>=1&&newData.val().length<=80"
              },
              "hp": {
                ".validate": "newData.isString()&&newData.val().length<=100&&(newData.val().matches(/^[0-9+ -]{6,20}$/)||newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/))"
              },
              "institusi": {
                ".validate": "newData.isString()&&newData.val().length>=1&&newData.val().length<=100"
              },
              "receiver": {
                ".validate": "newData.isString()&&newData.val().matches(/^[A-J](00[1-9]|0[1-9][0-9]|100)$/)"
              },
              "unitAsal": {
                ".validate": "newData.isString()&&newData.val().matches(/^[A-J](00[1-9]|0[1-9][0-9]|100)$/)"
              },
              "waktu": {
                ".validate": "newData.val()===now"
              },
              "status": {
                ".validate": "newData.val()==='dipinjam'||newData.val()==='kembali'||newData.val()==='tidakKembali'"
              },
              "uid": {
                ".validate": "newData.isString()&&newData.val().length<=64"
              },
              "grup": {
                ".validate": "newData.isString()&&newData.val().length>=1&&newData.val().length<=100"
              },
              "jaminan": {
                ".validate": "newData.isString()&&newData.val().matches(/^[a-z]{2,12}$/)"
              },
              "catatanGanti": {
                ".validate": "newData.isString()&&newData.val().length>=0&&newData.val().length<=200"
              },
              "kembaliWaktu": {
                ".validate": "newData.isNumber()"
              },
              "kembaliOleh": {
                ".validate": "newData.isString()&&newData.val().length>=0&&newData.val().length<=80"
              },
              "reminderTerakhir": {
                ".validate": "newData.isNumber()"
              },
              "reminderJumlah": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "nilai": {
            ".read": "auth!=null&&(root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()||root.child('sis/acara/'+$eid+'/petugas/'+root.child('sis/sesi/'+auth.uid).val()).exists())",
            ".write": "auth!=null&&(root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()||root.child('sis/acara/'+$eid+'/petugas/'+root.child('sis/sesi/'+auth.uid).val()).exists())",
            "$uid": {
              ".read": "auth!=null&&$uid===auth.uid",
              ".write": "(auth!=null&&(root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()||root.child('sis/acara/'+$eid+'/petugas/'+root.child('sis/sesi/'+auth.uid).val()).exists()))||(auth!=null&&auth.uid===$uid&&!data.exists())",
              ".validate": "newData.hasChildren(['pelayanan','alat','waktu'])",
              "pelayanan": {
                ".validate": "newData.isNumber()&&newData.val()>=1&&newData.val()<=5&&newData.val()%1===0"
              },
              "alat": {
                ".validate": "newData.isNumber()&&newData.val()>=1&&newData.val()<=5&&newData.val()%1===0"
              },
              "komentar": {
                ".validate": "newData.isString()&&newData.val().length>=0&&newData.val().length<=300"
              },
              "waktu": {
                ".validate": "newData.val()===now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "stok": {
            ".read": "auth!=null&&(root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()||root.child('sis/acara/'+$eid+'/petugas/'+root.child('sis/sesi/'+auth.uid).val()).exists())",
            ".write": "auth!=null&&(root.child('sis/superDaftar/'+root.child('sis/sesi/'+auth.uid).val()).exists()||root.child('sis/acara/'+$eid+'/petugas/'+root.child('sis/sesi/'+auth.uid).val()).exists())",
            "log": {
              "$id": {
                ".validate": "newData.hasChildren(['jenis','jumlah','oleh','waktu'])",
                "jenis": {
                  ".validate": "newData.val()==='terima'||newData.val()==='susulan'||newData.val()==='retur'||newData.val()==='selesai'"
                },
                "jumlah": {
                  ".validate": "newData.isNumber()&&newData.val()>=0&&newData.val()<=9999&&newData.val()%1===0"
                },
                "kurang": {
                  ".validate": "newData.isNumber()&&newData.val()>=0&&newData.val()<=9999&&newData.val()%1===0"
                },
                "oleh": {
                  ".validate": "newData.isString()&&newData.val().length>=1&&newData.val().length<=80"
                },
                "teknisi": {
                  ".validate": "newData.isString()&&newData.val().length>=0&&newData.val().length<=80"
                },
                "catatan": {
                  ".validate": "newData.isString()&&newData.val().length>=0&&newData.val().length<=600"
                },
                "waktu": {
                  ".validate": "newData.val()===now"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}